# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=real_estate_app

# Backend
SECRET_KEY=replace-with-a-random-secret-key

# Semantic Search (Claude AI — optional, only for AI Search feature)
ANTHROPIC_API_KEY=sk-ant-...

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OneMap API（用于 reverse_geocode_district.py）
# 注册地址: https://developers.onemap.sg/register/
ONEMAP_EMAIL=your_onemap_email@example.com
ONEMAP_PASSWORD=your_onemap_password
# 下面的 token 由 pipeline/refresh_onemap_token.py 自动刷新，勿手动编辑
ONEMAP_TOKEN=
